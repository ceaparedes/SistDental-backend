# Puerto HTTP de la API
PORT=3000

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL=postgresql://sistdental:sistdental@localhost:5432/sistdental?schema=public

# Secretos JWT: usa valores largos y aleatorios en producción
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
JWT_REFRESH_TTL=7d

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Superadmin inicial que crea el seed
SEED_SUPERADMIN_EMAIL=admin@sistdental.local
SEED_SUPERADMIN_PASSWORD=Admin1234!
